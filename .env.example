# Copy names only. Real values are written to .env by `stripe projects add ...` / `stripe projects env --pull`.
# Never commit .env. Never print values.

# CreateOS Sandbox. Stripe Projects writes CREATEOS_PROJECT_*; the SDK natively reads CREATEOS_SANDBOX_*.
# The runner accepts either key. CREATEOS_PROJECT_API_URL is the NodeOps account API, not the sandbox
# control plane, so the runner defaults the sandbox plane to the EU endpoint below.
CREATEOS_PROJECT_API_KEY=
CREATEOS_SANDBOX_BASE_URL=https://api-eu.sb.createos.sh

# LLM provider (OpenAI-compatible endpoint). Default: OpenRouter provisioned via Stripe Projects.
OPENROUTER_API_KEY=
# Optional overrides. Default model: openai/gpt-4o-mini.
RECOVERLY_MODEL=
RECOVERLY_LLM_BASE_URL=

# Optional shared passcode for a public demo: API routes then require the x-access-code header.
RECOVERLY_ACCESS_CODE=

# Safety switch: customer message delivery stays off unless this is exactly "true". No delivery adapter ships.
RECOVERLY_ENABLE_SEND=false

# Used in drafted messages.
BUSINESS_NAME=Acme Cloud (demo)
SUPPORT_CONTACT=support@example.test
