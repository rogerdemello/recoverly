{
  "name": "recoverly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Failed payment recovery agent: writes and runs analysis code in a CreateOS Sandbox.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spike:sandbox": "tsx --env-file=.env scripts/sandbox-spike.ts",
    "analyze": "tsx --env-file=.env scripts/run-analysis.ts",
    "capture:golden": "tsx --env-file=.env scripts/capture-golden.ts",
    "test:sandbox": "tsx scripts/run-sandbox-tests.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@nodeops-createos/sandbox": "0.8.2",
    "next": "16.4.2",
    "openai": "7.36.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
